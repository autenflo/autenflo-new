---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { cities } from '../../data/places';
export const getStaticPaths=async()=>(await getCollection('blog',p=>!p.data.draft)).map(p=>({params:{slug:p.slug},props:{p}}));
const { p } = Astro.props; const { Content } = await p.render(); const d=p.data;
const city=cities.find(c=>c.slug===d.city);
const ld=[{'@type':'BlogPosting',headline:d.title,description:d.description,datePublished:d.date.toISOString(),dateModified:(d.updated||d.date).toISOString(),image:new URL(d.image||'/og.png',Astro.site).href,author:{'@id':'https://autenflo.com/#org'},publisher:{'@id':'https://autenflo.com/#org'},mainEntityOfPage:new URL(Astro.url.pathname,Astro.site).href,inLanguage:'hi-IN'}];
---
<Base title={d.title.length>52?d.title:`${d.title} | autenflo`} desc={d.description} type="article" image={d.image||'/og.png'} ld={ld} crumbs={[['Home','/'],['Blog','/blog/'],[d.title,`/blog/${p.slug}/`]]}><article class="wrap sec"><h1>{d.title}</h1><p class="mut">{d.date.toLocaleDateString('en-IN')} · {d.tag}</p><div class="prose"><Content/></div>{city&&<p><br/><a class="btn" href={`/city/${city.slug}/`}>{city.name} me autenflo</a></p>}</article></Base>
